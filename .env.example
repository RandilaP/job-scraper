# MongoDB Configuration
PROD_MONGODB_URI=your_mongodb_connection_string

# Logtail Configuration
LOGTAIL_TOKEN=your_logtail_token

# Environment
ENVIRONMENT=production
HOSTNAME=job-extractor-server

# Job Source Configuration
# Options: 'greenhouse', 'workday', or 'both'
JOB_SOURCE=both

# Workday Parallel Processing Configuration
WORKDAY_PARALLEL_WORKERS=14
WORKDAY_BATCH_SIZE=100

# MongoDB Connection Pool Configuration (for parallel processing)
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10

# OpenSearch Configuration (Optional)
OPENSEARCH_HOST=your-cluster.db.ondigitalocean.com
OPENSEARCH_PORT=25060
OPENSEARCH_USERNAME=doadmin
OPENSEARCH_PASSWORD=your_opensearch_password
OPENSEARCH_USE_SSL=true
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_JOB_INDEX=jobs
OPENSEARCH_BULK_SIZE=500
